rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Verify requester is authenticated via Firebase Auth
    function signedIn() {
      return request.auth != null;
    }

    // Helper: Verify requester is NOT an anonymous user
    function isNonAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Helper: Strictly verify requester is admin via Custom Claim or Firestore admins/{uid} document
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }

    // Helper: Validate image file upload properties (create / update only)
    function isValidImageUpload() {
      return request.resource != null &&
        request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // ========================================================================
    // PROTECTED CLINICAL TREATMENT REVIEWS (treatment-reviews/**)
    // Protected handwriting originals and patient documents
    // Unauthenticated: DENY | Anonymous: DENY | Member: READ ONLY | Admin: WRITE
    // ========================================================================
    match /treatment-reviews/{reviewId}/{fileName} {
      // 1. Read: Strictly blocked for all direct clients (Streamed via streamReviewOriginal Admin SDK)
      allow read: if false;

      // 2. Create & Update: Verified Admin only + Image MIME and size validation
      allow create, update: if isAdmin() && isValidImageUpload();

      // 3. Delete: Verified Admin only (request.resource is null on delete)
      allow delete: if isAdmin();
    }

    // ========================================================================
    // PUBLIC REVIEW NON-SENSITIVE PREVIEWS (public-review-previews/**)
    // Non-identifying graphics, badges, or illustrations
    // ========================================================================
    match /public-review-previews/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageUpload();
    }

    // Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
