rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================

    // Strictly check if requester is authenticated admin via Custom Claim or admins/{uid} document
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Allowed category whitelist for public Q&A
    function isValidCategory(cat) {
      return cat in [
        'tic', 'adhd', 'panic', 'anxiety', 'sleep',
        'autonomic', 'hyperhidrosis', 'ibs', 'headache',
        'depression', 'child', 'fatigue', 'etc'
      ];
    }

    // Status and Answer consistency check
    function isStatusAnswerConsistent() {
      let reqData = request.resource.data;
      let resData = resource.data;

      return (
        // Case A: Status is 'pending' -> must NOT have answer or answeredAt
        (reqData.status == 'pending' &&
         !('answer' in reqData) &&
         !('answeredAt' in reqData)) ||

        // Case B: Status is 'answered' -> must have valid answer and answeredAt
        (reqData.status == 'answered' &&
         'answer' in reqData &&
         reqData.answer is string &&
         reqData.answer.size() >= 1 &&
         reqData.answer.size() <= 5000 &&
         'answeredAt' in reqData &&
         reqData.answeredAt is timestamp &&
         // Transition pending -> answered requires server timestamp; editing answered post preserves existing answeredAt
         (resData.status == 'pending' ? reqData.answeredAt == request.time : reqData.answeredAt == resData.answeredAt))
      );
    }

    // Validation for new question creation (Anonymous / Public)
    function isCreateValid() {
      let data = request.resource.data;
      let allowedCreateKeys = ['nickname', 'title', 'content', 'category', 'status', 'createdAt'];

      return (
        // 1. Must only contain strictly allowed public fields (No redundant ID or private fields)
        data.keys().hasOnly(allowedCreateKeys) &&

        // 2. Status must strictly be 'pending' upon creation
        data.status == 'pending' &&

        // 3. Field type and length limits
        data.nickname is string &&
        data.nickname.size() >= 1 &&
        data.nickname.size() <= 30 &&

        data.title is string &&
        data.title.size() >= 2 &&
        data.title.size() <= 100 &&

        data.content is string &&
        data.content.size() >= 5 &&
        data.content.size() <= 3000 &&

        // 4. Category whitelist
        isValidCategory(data.category) &&

        // 5. Creation timestamp must be server timestamp
        data.createdAt == request.time &&

        // 6. Prohibit answer and admin fields on creation
        !('answer' in data) &&
        !('answeredAt' in data) &&
        !('updatedAt' in data) &&
        !('admin' in data) &&
        !('isAdmin' in data) &&
        !('role' in data) &&
        !('answeredBy' in data)
      );
    }

    // Validation for question updating (Admin only)
    function isUpdateValid() {
      let data = request.resource.data;
      let allowedUpdateKeys = ['nickname', 'title', 'content', 'category', 'status', 'createdAt', 'answer', 'answeredAt', 'updatedAt'];

      return (
        // 1. Must strictly restrict updated document to allowed schema fields (Prevents PII / arbitrary field injection)
        data.keys().hasOnly(allowedUpdateKeys) &&

        // 2. Immutable creation timestamp
        data.createdAt == resource.data.createdAt &&

        // 3. Status must strictly be 'pending' or 'answered'
        data.status in ['pending', 'answered'] &&

        // 4. Base fields validation
        data.nickname is string &&
        data.nickname.size() >= 1 &&
        data.nickname.size() <= 30 &&

        data.title is string &&
        data.title.size() >= 2 &&
        data.title.size() <= 100 &&

        data.content is string &&
        data.content.size() >= 5 &&
        data.content.size() <= 3000 &&

        isValidCategory(data.category) &&

        // 5. Status & Answer consistency check
        isStatusAnswerConsistent() &&

        // 6. updatedAt must strictly be server timestamp on every update
        data.updatedAt == request.time
      );
    }

    // ========================================================================
    // PUBLIC Q&A BOARD COLLECTION (online_inquiries)
    // ========================================================================
    match /online_inquiries/{inquiryId} {
      // 1. Public Read (Anyone can view questions & answers)
      allow read: if true;

      // 2. Public Create (Subject to strict schema and 'pending' status)
      allow create: if isCreateValid();

      // 3. Admin Update (Strictly validated schema, immutable createdAt, serverTimestamp updatedAt, answer consistency)
      allow update: if isAdmin() && isUpdateValid();

      // 4. Admin Delete
      allow delete: if isAdmin();
    }

    // ========================================================================
    // ADMIN IDENTIFIER COLLECTION (admins/{uid})
    // ========================================================================
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Managed exclusively via Firebase Console / Server
    }

    // ========================================================================
    // DEFAULT DENY FOR ALL OTHER PATHS
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
